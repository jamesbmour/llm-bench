/* Every color is a theme variable so Ctrl+T (or --theme) re-skins the whole application. */

Screen {
    background: $background;
    color: $foreground;
}

/* ── Chrome ─────────────────────────────────────────────────────────────── */
TitleBar { height: 1; padding: 0 2; background: $primary 20%; }
.title-brand { width: auto; padding: 0 1 0 0; color: $primary; text-style: bold; }
.title-screen { width: 1fr; color: $text; text-style: bold; }
.title-context { width: 1fr; text-align: right; color: $text-muted; }
StatusBar { height: 1; padding: 0 2; background: $panel; color: $text-muted; }
.status-left { width: 1fr; }
.status-right { width: auto; text-align: right; }
.section-note { height: 2; padding: 1 2 0 2; color: $text-muted; }

/* ── Inputs ─────────────────────────────────────────────────────────────── */
Input { border-title-color: $text-muted; border-title-style: bold; }
Input:focus { border-title-color: $primary; }

/* ── Picker ─────────────────────────────────────────────────────────────── */
#picker-inputs { height: 3; margin: 0 1; }
#picker-inputs Input { width: 1fr; margin: 0 1; }
#model-picker { height: 1fr; margin: 0 2; border: round $border; background: $surface; }
#picker-footer { height: 3; margin: 0 2; }
#selection-summary { width: 1fr; height: 3; padding: 1 1 0 0; color: $text; }
#run-selected { width: auto; }

/* ── Live ───────────────────────────────────────────────────────────────── */
#run-header { height: 1; margin: 1 2 0 2; }
#run-clock { width: auto; padding: 0 2 0 0; color: $text; }
#run-progress { width: 1fr; height: 1; }
#run-progress Bar { width: 1fr; }
#live-scroll { height: 1fr; }
/* grid-rows must match ModelCard height: an auto-height grid sizes rows from child content,
   not from the child's declared height, which would clip the sparkline and tool timeline. */
#card-grid {
    layout: grid;
    grid-size: 2;
    grid-rows: 27;
    grid-gutter: 1 2;
    height: auto;
    padding: 1 2;
}
.narrow #card-grid { grid-size: 1; }
.zoomed #card-grid { grid-size: 1; grid-rows: 1fr; height: 1fr; }
.zoomed ModelCard { display: none; }
.zoomed ModelCard.zoom-target { display: block; height: 1fr; }
ModelCard {
    height: 27;
    padding: 0 1;
    border: round $border;
    border-title-color: $text;
    border-title-style: bold;
    background: $surface;
}
ModelCard.status-running { border: round $primary; }
ModelCard.status-completed { border: round $success; }
ModelCard.status-error { border: round $error; }
ModelCard.status-cancelled { border: round $warning; }
ModelCard:focus { background: $surface-lighten-1; border-title-style: bold reverse; }
.card-status { height: 1; }
.card-state { width: auto; padding: 0 1 0 0; color: $text-muted; text-style: bold; }
.status-running .card-state { color: $primary; }
.status-completed .card-state { color: $success; }
.status-error .card-state { color: $error; }
.status-cancelled .card-state { color: $warning; }
.card-progress { width: 1fr; color: $text; }
.card-metrics { height: 1; color: $text-muted; }
.stream-pane { height: 1fr; min-height: 6; margin: 0 0 1 0; background: $background; }
.speed-graph { height: 2; }
.speed-graph > .sparkline--max-color { color: $primary; }
.speed-graph > .sparkline--min-color { color: $primary 30%; }
.tool-timeline { height: 5; }
#verbose-log { height: 7; margin: 0 2; border: round $border; background: $surface; }

/* ── Results ────────────────────────────────────────────────────────────── */
#results-filter { margin: 0 2; }
#results-description { height: 1; padding: 0 2; color: $text-muted; }
#results-table { height: 1fr; margin: 0 2; border: round $border; background: $surface; }
#results-detail {
    height: auto;
    max-height: 10;
    margin: 0 2;
    padding: 0 1;
    border-top: solid $border;
    color: $text-muted;
}

/* ── Comparison ─────────────────────────────────────────────────────────── */
#compare-filter-bar { height: 3; margin: 0 1; }
#compare-filter-bar Input { width: 1fr; margin: 0 1; }
#compare-toolbar { height: 3; margin: 0 2; }
#compare-toolbar Button { margin: 0 1 0 0; }
#compare-description { width: 1fr; height: 3; padding: 1 1 0 0; color: $text-muted; }
#compare-content { height: 1fr; margin: 0 2; }
#compare-plot { height: auto; min-height: 8; margin: 0 0 1 0; padding: 1 1; border: round $border; background: $surface; }
#compare-table { height: 12; min-height: 6; margin: 0 0 1 0; border: round $border; background: $surface; }
#compare-detail { height: auto; max-height: 8; padding: 0 1; border-top: solid $border; color: $text-muted; }

/* ── Coverage ───────────────────────────────────────────────────────────── */
#coverage-filter-bar { height: 3; margin: 0 1; }
#coverage-filter-bar Input { width: 1fr; margin: 0 1; }
#coverage-toolbar { height: 3; margin: 0 2; }
#coverage-toolbar Button { margin: 0 1 0 0; }
#coverage-description { width: 1fr; height: 3; padding: 1 1 0 0; color: $text-muted; }
#coverage-content { height: 1fr; margin: 0 2; }
#coverage-table { height: 14; min-height: 8; margin: 0 0 1 0; border: round $border; background: $surface; }
#coverage-detail { height: auto; max-height: 12; padding: 0 1; border-top: solid $border; color: $text-muted; }

/* ── Tables ─────────────────────────────────────────────────────────────── */
DataTable > .datatable--header { background: $panel; color: $text; text-style: bold; }
DataTable > .datatable--cursor { background: $primary 30%; color: $text; }
DataTable:focus > .datatable--cursor { background: $primary 55%; }

/* ── Dialogs ────────────────────────────────────────────────────────────── */
ModalScreen { align: center middle; background: $background 70%; }
.dialog {
    width: 90%;
    height: 85%;
    padding: 1 2;
    border: thick $primary;
    border-title-color: $primary;
    border-title-style: bold;
    background: $surface;
}
.dialog RichLog { height: 1fr; background: $background; }
#transcript-title { height: 2; color: $text; text-style: bold; }
.path-dialog {
    width: 80%;
    height: auto;
    padding: 1 2;
    border: thick $primary;
    border-title-color: $primary;
    border-title-style: bold;
    background: $surface;
}
.path-dialog Static { height: 2; color: $text; }
.path-dialog Input { margin: 0 0 1 0; }
.help-dialog { width: 84%; }
#help-bindings { height: 1fr; background: $background; }
#help-legend { height: auto; padding: 1 0 0 0; color: $text-muted; }

/* ── Monochrome (--no-color / NO_COLOR) ─────────────────────────────────── */
.monochrome Screen, .monochrome Screen * { color: white; background: black; border: none; }
.monochrome ModelCard, .monochrome .dialog, .monochrome .path-dialog, .monochrome Input,
.monochrome #model-picker, .monochrome #results-table, .monochrome #verbose-log,
.monochrome #compare-plot, .monochrome #compare-table,
.monochrome #coverage-filter-bar Input, .monochrome #coverage-table {
    border: round white;
    border-title-color: white;
}
.monochrome #results-detail, .monochrome #compare-detail, .monochrome #coverage-detail {
    border-top: solid white;
}
.monochrome DataTable > .datatable--header { text-style: bold underline; }
.monochrome DataTable > .datatable--cursor { background: white; color: black; }
.monochrome Sparkline > .sparkline--max-color { color: white; }
.monochrome Sparkline > .sparkline--min-color { color: white 50%; }
